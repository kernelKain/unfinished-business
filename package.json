{
  "name": "unfinished-business",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:contracts": "node --import tsx --test tests/contracts.test.ts tests/prompts.test.ts",
    "test:permissions": "node --import tsx --test tests/native-permissions.test.ts",
    "test:workflow": "node --import tsx --test tests/workflow.test.ts",
    "test:recovery": "node --import tsx --test tests/recovery.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@opencode/client": "2.0.32",
    "hono": "4.13.14",
    "lucide-react": "1.65.0",
    "motion": "14.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}

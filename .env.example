# Public Sentry DSNs may be committed. Never put passwords, auth tokens, provider API keys, or model credentials in this file.
# OpenCode provider accounts and API keys belong in OpenCode's own credential store, not here.
OPENCODE_BASE_URL=http://127.0.0.1:4096
# Optional for non-interactive local starts. The wizard holds a password in memory instead.
# Use the password printed by `opencode serve`, or the fixed OPENCODE_SERVER_PASSWORD you chose.
OPENCODE_PASSWORD=
UB_PORT=4200
UB_HOST=127.0.0.1
UB_DATA_DIR=.unfinished-business
# local | hosted-private | hosted-demo
UB_DEPLOYMENT_MODE=local
UB_SESSION_TOKEN=
# Required for a public production deployment; optional for loopback-only development.
UB_ACCESS_USERNAME=unfinished-business
UB_ACCESS_PASSWORD=
SENTRY_DSN=https://e0fb5afecfe3b6683c87b189fe431e92@o4512343451435008.ingest.de.sentry.io/4512349803577424
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=1
SENTRY_AGENT_TRACES_SAMPLE_RATE=1
SENTRY_PROFILES_SAMPLE_RATE=1
VITE_SENTRY_DSN=https://62d2843b479e9ef671941ae38d95e893@o4512343451435008.ingest.de.sentry.io/4512349804167248
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1
# Build-time secret/configuration. Put the token in .env or your CI secret store, never here.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=kernelkain
SENTRY_PROJECT=unfinished-business-web
SENTRY_DEPLOY_ENVIRONMENT=
BACKBOARD_API_KEY=

# Local defaults. Never put passwords, auth tokens, or provider keys in this file.
# Public Sentry DSNs may be committed; secret tokens may not.
UB_MODE=local
OPENCODE_BASE_URL=http://127.0.0.1:4096
# Use the password printed by `opencode serve`, or the fixed OPENCODE_SERVER_PASSWORD you chose.
OPENCODE_PASSWORD=
UB_PORT=4200
UB_HOST=127.0.0.1
UB_DATA_DIR=.unfinished-business
UB_SESSION_TOKEN=
# Required for hosted modes; optional for loopback-only development.
UB_ACCESS_USERNAME=unfinished-business
UB_ACCESS_PASSWORD=
# Hosted modes only: explicit public HTTPS origin. Render derives it from RENDER_EXTERNAL_HOSTNAME.
UB_PUBLIC_URL=
UB_ALLOWED_HOSTS=
UB_ALLOWED_ORIGINS=
UB_TRUST_PROXY=false

# Render start helper (optional outside Render).
# OPENCODE_PORT=4096
# OPENCODE_DATA_HOME=/var/data/xdg-data
# OPENCODE_CONFIG_HOME=/var/data/xdg-config

# OpenCode remote/network policy. Defaults are loopback + no remote targets.
UB_OPENCODE_ALLOW_INSECURE_REMOTE=false
UB_OPENCODE_ALLOWED_HOSTS=
UB_OPENCODE_ALLOWED_PORTS=
UB_OPENCODE_ALLOW_PRIVATE_NETWORK=false
UB_OPENCODE_REQUEST_TIMEOUT_MS=300000
UB_OPENCODE_MAX_RESPONSE_BYTES=8388608

# HTTP and run budgets/limits.
UB_MAX_REQUEST_BYTES=65536
UB_RATE_LIMIT_PER_MINUTE=120
UB_MAX_CONCURRENT_MUTATIONS=1
UB_MAX_SSE_CONNECTIONS=4
UB_GUIDE_TIMEOUT_MS=90000
UB_MAKER_TIMEOUT_MS=180000
UB_NODE_CHECK_TIMEOUT_MS=30000
UB_MAX_SESSION_TOKENS=200000
UB_MAX_SESSION_COST_USD=0

# Retention. Idempotency is guaranteed only within the retained action window.
UB_RETENTION_ACTIONS=500
UB_RETENTION_APPROVALS=200
UB_RETENTION_OPERATIONS=200
UB_RETENTION_EVIDENCE=200
UB_RETENTION_TRANSCRIPT=40
UB_RETENTION_WITNESS_DRAFTS=10
UB_BACKUP_COUNT=3
UB_CORRUPT_FILE_COUNT=5
UB_BACKUP_MAX_AGE_DAYS=30

# Redaction/logging.
UB_REDACT_PROMPTS=false
UB_REDACT_LOCAL_PATHS=false
UB_LOG_LEVEL=info

# Optional Sentry. DSNs are public project identifiers, not auth tokens.
SENTRY_DSN=https://e0fb5afecfe3b6683c87b189fe431e92@o4512343451435008.ingest.de.sentry.io/4512349803577424
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=1
SENTRY_AGENT_TRACES_SAMPLE_RATE=1
SENTRY_PROFILES_SAMPLE_RATE=1
VITE_SENTRY_DSN=https://62d2843b479e9ef671941ae38d95e893@o4512343451435008.ingest.de.sentry.io/4512349804167248
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1
# Build-time secret/configuration. Put the token in .env or your CI secret store, never in source.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=kernelkain
SENTRY_PROJECT=unfinished-business-web
SENTRY_DEPLOY_ENVIRONMENT=
